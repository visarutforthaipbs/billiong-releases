---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "บิลง่าย (BillNgai) — ออกบิลไว เก็บเงินง่าย จัดการภาษีฟรีแลนซ์ไทยครบวงจร",
	description = "แอปออกบิลและจัดการภาษีที่สร้างเพื่อฟรีแลนซ์ไทย — ใบเสนอราคา ใบแจ้งหนี้ ใบกำกับภาษี แบ่งงวดตาม TOR ตัวเลขพร้อมยื่น ภ.ง.ด.90/94 ข้อมูลอยู่ในเครื่องคุณ"
} = Astro.props;

// Construct Schema.org JSON-LD for AI search engines (AIEO) & Google
const schemaMarkup = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "บิลง่าย (BillNgai)",
  "softwareVersion": "1.4.0",
  "operatingSystem": "macOS, Windows",
  "applicationCategory": "BusinessApplication, FinanceApplication",
  "description": description,
  "image": "/thumnail-1.4.jpg",
  "featureList": [
    "ผู้ช่วยประมาณการภาษีเงินได้ ภ.ง.ด.90/94 แยกตามสองรอบระยะเวลาสะสมภาษีจริง",
    "ระบบจัดสรรแบ่งรับเงินงวดตามข้อตกลง TOR บนเอกสารใบเสนอราคาพร้อมแถบสถานะความคืบหน้า",
    "ตัวคำนวณและผลิตรูป PromptPay EMVCo SVG QR Code ท้องถิ่นแบบออฟไลน์",
    "ฟังก์ชันดาวน์โหลดรวบรวมชุดไฟล์ ZIP รายการรับเงินและภาษีหัก ณ ที่จ่าย 50 ทวิ ส่งสรรพากร"
  ],
  "offers": {
    "@type": "Offer",
    "price": "59.00",
    "priceCurrency": "THB",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock"
  }
};

const ogImageUrl = new URL("/thumnail-1.4.jpg", Astro.site || "https://billiong-releases.pages.dev").href;
---

<!doctype html>
<html lang="th">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="ออกใบเสร็จ, ใบแจ้งหนี้, ใบกำกับภาษี, คำนวณหัก ณ ที่จ่าย, 50 ทวิ, ฟรีแลนซ์, โปรแกรมบัญชี, macOS, Windows, Local-First, พร้อมเพย์ QR, PromptPay QR, บัญชีภาษีฟรีแลนซ์" />
		<meta name="robots" content="index, follow" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImageUrl} />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		
		<!-- AIEO (AI Engine Optimization) JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

		<!-- Brand fonts are self-hosted (see global.css @font-face) — no external font requests -->
	</head>
	<body class="font-sans antialiased bg-[#FFF9F3] text-[#2D3436] selection:bg-[#FF6B00]/20 selection:text-[#E05E00]">
		<slot />
	</body>
</html>
