---
import '../styles/global.css';
import { product } from '../config/product';

interface Props {
	title?: string;
	description?: string;
	/** 'support' omits price offers from JSON-LD — /support is the App Store
	    Support URL and must stay free of pricing (see drafts/support-page-th.md) */
	variant?: 'product' | 'support';
}

const {
	title = "บิลง่าย (BillNgai) 2.1.0 บน App Store — iPhone, iPad และ Mac — เอกสารสำหรับฟรีแลนซ์ไทย",
	description = "BillNgai 2.1.0 บน App Store: ใบเสนอราคา ใบแจ้งหนี้ และใบเสร็จธรรมดาสำหรับผู้ไม่จด VAT รับเต็มจำนวนเป็นเงินบาท ไม่รองรับใบกำกับภาษี พักประมาณการภาษีและ e-Tax ใช้ได้บน iPhone, iPad และ Mac อัปเดตอัตโนมัติผ่าน App Store",
	variant = 'product'
} = Astro.props;

const localOffer = product.prices.local;
const proOffer = product.prices.pro;

// Construct Schema.org JSON-LD for AI search engines (AIEO) & Google
const schemaMarkup = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "บิลง่าย (BillNgai)",
  "softwareVersion": variant === 'support' ? undefined : "2.1.0",
  "operatingSystem": "iOS, iPadOS, macOS",
  "applicationCategory": "BusinessApplication, FinanceApplication",
  "description": description,
	"image": new URL("/assets/brand/clay/logo-b-clay.webp", Astro.site || "https://billiong-landing.pages.dev").href,
	"url": new URL(Astro.url.pathname, Astro.site || "https://billiong-landing.pages.dev").href,
  "featureList": [
    "BillNgai 2.1.0 บน App Store: ใบเสนอราคา ใบแจ้งหนี้ และข้อมูลรายรับในเครื่อง ใช้ได้บน iPhone, iPad และ Mac",
    "ใบเสร็จธรรมดา: ผู้ยืนยันว่าไม่จด VAT รับเต็มจำนวนเป็นเงินบาทเท่านั้น",
    "ผู้ใช้ตรวจภาษีหัก ณ ที่จ่ายก่อนออกใบเสร็จ ไม่ใช่อัตรา 3% อัตโนมัติ",
    "จัดประเภทเงินได้ได้ใน Local โดยไม่ต้องซื้อ Pro",
    "พักประมาณการภาษีและ e-Tax; Pro ซิงก์ผ่าน Google Drive ของผู้ใช้เอง",
    "Pro: ซิงก์ Google Drive หลายเครื่อง ซื้อครั้งเดียวในแอปผ่าน Apple ID"
  ],
  ...(variant === 'support' ? {} : {
  "offers": [
    {
      "@type": "Offer",
      "name": "BillNgai Local",
      "price": localOffer.price,
      "priceCurrency": "THB",
      "priceValidUntil": "2027-12-31",
      "availability": "https://schema.org/InStock"
    },
    {
      "@type": "Offer",
      "name": "BillNgai Pro",
      "price": proOffer.price,
      "priceCurrency": "THB",
      "priceValidUntil": "2027-12-31",
      "availability": "https://schema.org/InStock"
    }
  ]
  })
};

const ogImageUrl = new URL("/assets/brand/clay/logo-b-clay.webp", Astro.site || "https://billiong-landing.pages.dev").href;
const pageUrl = new URL(Astro.url.pathname, Astro.site || "https://billiong-landing.pages.dev").href;
---

<!doctype html>
<html lang="th">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<link rel="canonical" href={pageUrl} />
		<meta name="description" content={description} />
		<meta name="keywords" content="ใบเสร็จธรรมดา, ใบแจ้งหนี้, ใบเสนอราคา, ฟรีแลนซ์, iPhone, iPad, macOS, Local-First, พร้อมเพย์ QR, BillNgai" />
		<meta name="robots" content="index, follow" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImageUrl} />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		
		<!-- AIEO (AI Engine Optimization) JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

		<!-- Brand fonts are self-hosted (see global.css @font-face) — no external font requests -->
	</head>
	<body class="font-sans antialiased bg-[#FFF9F3] text-text-dark selection:bg-[#FF6B00]/20 selection:text-accent-ink">
		<slot />
		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>
