---
import { Laptop } from '@lucide/astro';
import ReleaseNotice from './ReleaseNotice.astro';
---

<section id="web-app" class="py-16 md:py-24 bg-accent-bg border-y border-border-custom">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    <div class="text-center space-y-4">
      <Laptop size={32} class="mx-auto text-text-muted" />
      <h2 class="text-3xl font-bold text-text-dark">อ่านก่อนอัปเดตเป็น 2.0.3</h2>
      <p class="text-text-muted">พักเดโมรุ่นเก่า เพราะแสดงฟีเจอร์ที่รุ่นนี้ไม่รองรับ</p>
    </div>
    <ReleaseNotice />
  </div>
</section>
