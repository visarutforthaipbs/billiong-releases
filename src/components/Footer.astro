---
import { product } from '../config/product';

const text = "© 2026 บิลง่าย (BillNgai) — แอปบิลและภาษีที่สร้างเพื่อฟรีแลนซ์ไทย ข้อมูลอยู่ในเครื่องคุณ";
---

<footer id="footer" class="bg-slate-50 border-t border-slate-200/80 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
    
    <!-- Highlighted Beta Feedback Section -->
    <div class="max-w-md mx-auto bg-white border border-border-custom rounded-md p-5 shadow-xs text-center space-y-3">
      <div class="inline-flex items-center gap-1.5 bg-[#06C755]/10 text-[#06C755] border border-[#06C755]/20 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider animate-pulse">
        Beta Feedback
      </div>
      <h3 class="text-sm font-bold text-text-dark">ร่วมเสนอแนะ & พัฒนา บิลง่าย ไปด้วยกัน</h3>
      <p class="text-xs text-text-muted leading-relaxed max-w-sm mx-auto">
        พบปัญหาการใช้งาน มีข้อสงสัย หรือต้องการเสนอแนะฟีเจอร์ใหม่? คุยกับทีมพัฒนาโดยตรงทาง LINE ได้เลยครับ
      </p>
      <div class="flex justify-center">
        <a 
          href={product.lineUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-[#06C755] hover:bg-[#05b04b] rounded-sm shadow-xs transition-all active:scale-98 cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
          </svg>
          <span>คุยกับเราทาง LINE</span>
        </a>
      </div>
    </div>

    <!-- Navigation quicklinks in footer -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6 text-xs font-medium text-slate-400">
      <a href="#features" class="hover:text-slate-700 transition-colors">ฟีเจอร์หลัก</a>
      <a href="#security" class="hover:text-slate-700 transition-colors">ความปลอดภัยข้อมูล</a>
      <a href="#faq" class="hover:text-slate-700 transition-colors">คำถามที่พบบ่อย</a>
    </div>

    <!-- Copyright / Powered By -->
    <p class="text-xs text-slate-400 max-w-lg mx-auto leading-relaxed">
      {text}
    </p>

  </div>
</footer>
