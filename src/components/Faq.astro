---
import { ChevronDown, HelpCircle } from '@lucide/astro';
import { product } from '../config/product';

const title = "คำถามที่พบบ่อย (FAQ)";
const questions = [
  {
    q: "แอปนี้ต้องจ่ายค่าบริการรายเดือนไหม?",
    a: "ไม่ต้องจ่ายรายเดือนครับ บิลง่าย เป็นแอปพลิเคชันแบบ Local-first ที่รันบนเครื่องของคุณ ข้อมูลถูกเก็บไว้ในไฟล์บนคอมพิวเตอร์ของคุณเอง ไม่มีค่าบริการแอบแฝง"
  },
  {
    q: "ข้อมูลจะหายไหมถ้าคอมพิวเตอร์พัง?",
    a: "สำเนาในดิสก์เดียวกันอาจหายพร้อมเครื่องได้ เก็บฐานข้อมูล JSON และชุดไฟล์หลักฐานแยกกันนอกดิสก์เดิม JSON ไม่มีไฟล์แนบอยู่ข้างใน เก็บ PDF เดิมก่อนอัปเดต รุ่น 2.0.4 ยังพักซิงก์และกู้คืนคลาวด์ รวมถึง Pro หากข้อมูลผิดปกติ หยุดแก้ไขและติดต่อฝ่ายช่วยเหลือ อย่าลบไฟล์เดิม"
  },
  {
    q: "เอกสารเก่าเปิดไม่ได้ ต้องยกเลิกก่อนหรือเปล่า?",
    a: "ไม่ต้องยกเลิกเพื่ออ่านครับ รุ่น 2.0.4 เปิดดูข้อมูลเดิมที่เก็บไว้ได้ และแยกเก็บเข้าคลังออกจากการยกเลิก เอกสารที่ไม่มีสำเนาข้อมูล ณ วันออกยังพิมพ์/แชร์ใหม่ไม่ได้ ใบแจ้งหนี้เก่าค้างรับที่เข้าเงื่อนไขสามารถแนบหลักฐานและยืนยันการรับเต็มจำนวนเป็นเงินบาทกับสถานะไม่จด VAT ได้ จากนั้นเลือกออกใบเสร็จธรรมดาใหม่ด้วยวันที่ออกวันนี้ ไม่แก้ต้นฉบับหรือสร้างหลักฐานย้อนหลัง"
  },
  {
    q: "Local กับ Pro ต่างกันยังไง?",
    a: "Local ฟรี รองรับเอกสารตามข้อจำกัด 2.0.4 รวมการจัดประเภทเงินได้ Pro เพิ่มโมดูล AI ร่างใบเสนอราคาในเครื่องบน Mac Direct ต้องติดตั้งโมดูลเพิ่ม ข้อจำกัดใบเสร็จ ภาษี ซิงก์และกู้คืนคลาวด์ใช้กับทั้งสองแพ็กเกจ"
  },
  {
    q: "Pro ยังซิงก์ Google Drive ได้ไหม?",
    a: "รุ่น 2.0.4 พักการเชื่อมต่อ ซิงก์ และกู้คืนคลาวด์ ใช้ข้อมูลในเครื่องเดียว หากเคยซื้อ Pro เพื่อฟีเจอร์นี้ ติดต่อทีมงานก่อนอัปเดตหรือชำระเงิน ไม่มีกำหนดเปิดกลับที่รับรองได้"
  },
  {
    q: `BillNgai Local ฟรีจริงไหม แล้วต้องจ่ายเพิ่มทีหลังหรือเปล่า?`,
    a: `Local ฟรีสำหรับฟีเจอร์ที่รองรับ ไม่ต้องซื้อ Pro เพื่อจัดประเภทเงินได้ Pro Early Bird ${product.prices.pro.earlyBirdLabel} (ราคาเต็ม ${product.prices.pro.fullLabel}) ไม่ปลดล็อกฟีเจอร์ที่พักใน 2.0.4 กรุณาอ่านข้อจำกัดก่อนซื้อ`
  },
  {
    q: "BillNgai ใช้แทนนักบัญชีได้ไหม?",
    a: "ไม่ได้ครับ การตรวจด้วย AI และการทดสอบซอฟต์แวร์ไม่ใช่การรับรองจากนักบัญชีหรือที่ปรึกษากฎหมาย รุ่น 2.0.4 ไม่แสดงภาษีที่ต้องจ่ายหรือขอคืน ตรวจสถานะ VAT หลักฐานรับเงิน และหัก ณ ที่จ่ายกับผู้เชี่ยวชาญก่อนใช้จริง"
  },
  {
    q: "ระบบ PromptPay QR ปลอดภัยไหม?",
    a: "สร้าง QR ในเครื่องโดยไม่ใช้บริการสร้าง QR ภายนอก แต่ควรสแกนตรวจชื่อผู้รับและยอดเงินทุกครั้ง QR ไม่ใช่หลักฐานว่ารับชำระแล้ว"
  }
];
---

<section id="faq" class="py-20 md:py-28 bg-white border-t border-border-custom">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center justify-center p-2.5 rounded-full bg-primary/10 text-primary mb-4">
        <HelpCircle size={24} />
      </div>
      <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">
        {title}
      </h2>
      <p class="text-slate-500 text-sm md:text-base mt-2">
        ตอบทุกข้อสงสัยเกี่ยวกับระบบบัญชี Local-First และการจัดการความปลอดภัย
      </p>
    </div>

    <!-- Accordion Details list -->
    <div class="space-y-4">
      {questions.map((item) => (
        <details class="group border border-border-custom rounded-md overflow-hidden bg-slate-50/10 open:bg-white open:shadow-2xs transition-all duration-200">
          <summary class="flex items-center justify-between p-5 text-sm md:text-base font-bold text-slate-800 cursor-pointer list-none select-none focus:outline-none hover:text-primary hover:bg-slate-50/30">
            <span>{item.q}</span>
            <span class="chevron-wrapper text-slate-400 group-hover:text-primary transition-transform duration-300">
              <ChevronDown size={18} />
            </span>
          </summary>
          <div class="p-5 pt-0 text-sm md:text-base text-slate-500 border-t border-border-custom/50 leading-relaxed bg-white">
            {item.a}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  summary {
    display: flex;
  }

  details[open] .chevron-wrapper {
    transform: rotate(180deg);
    color: #FF6B00;
  }
</style>
