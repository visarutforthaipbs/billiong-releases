---
import { ChevronDown, HelpCircle } from '@lucide/astro';
import { product } from '../config/product';

const title = "คำถามที่พบบ่อย (FAQ)";
const questions = [
  {
    q: "แอปนี้ต้องจ่ายค่าบริการรายเดือนไหม?",
    a: "ไม่ต้องจ่ายรายเดือนครับ บิลง่าย เป็นแอปพลิเคชันแบบ Local-first ที่รันบนเครื่องของคุณ ข้อมูลถูกเก็บไว้ในไฟล์บนคอมพิวเตอร์ของคุณเอง ไม่มีค่าบริการแอบแฝง"
  },
  {
    q: "ข้อมูลจะหายไหมถ้าคอมพิวเตอร์พัง?",
    a: "แอปเก็บสำเนาสำรองอัตโนมัติทุก 30 นาที (ย้อนหลัง 30 ชุด) และในเวอร์ชัน 2.0 มีหน้าสำรอง-กู้คืนในแอป กดกู้คืนได้คลิกเดียว ส่วนผู้ใช้ Pro ยังสำรองขึ้น Google Drive ของตัวเองอัตโนมัติ และกู้คืนทั้งหมดบนคอมเครื่องใหม่ได้"
  },
  {
    q: "Local กับ Pro ต่างกันยังไง?",
    a: "Local (จ่ายครั้งเดียว) ออกเอกสารและจัดการภาษีครบทุกฟีเจอร์หลัก ข้อมูลอยู่ในเครื่องคุณ 100% ส่วน Pro (จ่ายครั้งเดียวเช่นกัน ไม่มีรายเดือน) เพิ่ม AI แปลง TOR เป็นใบเสนอราคาแบบออฟไลน์ ซิงก์ทำงานต่อได้หลายเครื่อง สำรองขึ้นคลาวด์อัตโนมัติ และเครื่องมือเตรียมภาษีตามประเภทเงินได้ (มาตรา 40)"
  },
  {
    q: "Pro ซิงก์ข้อมูลผ่านที่ไหน — BillNgai เห็นข้อมูลเราไหม?",
    a: "ไม่เห็นครับ ข้อมูลซิงก์ผ่าน Google Drive ของคุณเองเท่านั้น (สิทธิ์แบบ drive.file — แอปเห็นเฉพาะโฟลเดอร์ที่ตัวเองสร้าง) BillNgai ไม่มีเซิร์ฟเวอร์เก็บใบแจ้งหนี้ ลูกค้า หรือข้อมูลภาษีของคุณ และแอปยังทำงานออฟไลน์ได้ตามปกติ"
  },
  {
    q: `ซื้อ Early Bird ${product.prices.local.earlyBirdLabel} วันนี้ แล้วเวอร์ชัน 2.0 ต้องจ่ายเพิ่มไหม?`,
    a: `ไม่ต้องครับ Early Bird = BillNgai Local Lifetime ใช้ฟีเจอร์ Local ทุกอย่างได้ตลอดไป รวมอัปเดตในสาย 2.x และอัปเกรด/จองสิทธิ์เป็น Pro ได้ในราคา Early Bird ${product.prices.pro.earlyBirdLabel} (ราคาเต็ม ${product.prices.pro.fullLabel}) เมื่อเปิดขาย`
  },
  {
    q: "BillNgai ใช้แทนนักบัญชีได้ไหม?",
    a: "ไม่ได้โดยตรงครับ BillNgai ช่วยคำนวณ จัดระเบียบเอกสาร และเตรียมตัวเลขสำหรับใช้ประกอบการยื่นภาษี แต่ไม่ใช่สำนักงานบัญชีหรือที่ปรึกษาภาษี ผู้ใช้ควรตรวจสอบข้อมูลกับนักบัญชีหรือกรมสรรพากรก่อนยื่นจริง"
  },
  {
    q: "ระบบ PromptPay QR ปลอดภัยไหม?",
    a: "ปลอดภัย 100% ครับ เพราะ บิลง่าย ใช้ตัวเข้ารหัส EMVCo payload ที่เขียนขึ้นเองจากศูนย์ แปลงเป็น SVG QR Code ภายในตัวแอป โดยไม่มีการต่อสายนอกหรือส่งข้อมูลเลขบัญชี/เบอร์โทรของคุณไปยังเซิร์ฟเวอร์ใดๆ ทั้งสิ้น"
  }
];
---

<section id="faq" class="py-20 md:py-28 bg-white border-t border-border-custom">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center justify-center p-2.5 rounded-full bg-primary/10 text-primary mb-4">
        <HelpCircle size={24} />
      </div>
      <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">
        {title}
      </h2>
      <p class="text-slate-500 text-sm md:text-base mt-2">
        ตอบทุกข้อสงสัยเกี่ยวกับระบบบัญชี Local-First และการจัดการความปลอดภัย
      </p>
    </div>

    <!-- Accordion Details list -->
    <div class="space-y-4">
      {questions.map((item) => (
        <details class="group border border-border-custom rounded-md overflow-hidden bg-slate-50/10 open:bg-white open:shadow-2xs transition-all duration-200">
          <summary class="flex items-center justify-between p-5 text-sm md:text-base font-bold text-slate-800 cursor-pointer list-none select-none focus:outline-none hover:text-primary hover:bg-slate-50/30">
            <span>{item.q}</span>
            <span class="chevron-wrapper text-slate-400 group-hover:text-primary transition-transform duration-300">
              <ChevronDown size={18} />
            </span>
          </summary>
          <div class="p-5 pt-0 text-sm md:text-base text-slate-500 border-t border-border-custom/50 leading-relaxed bg-white">
            {item.a}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  summary {
    display: flex;
  }

  details[open] .chevron-wrapper {
    transform: rotate(180deg);
    color: #FF6B00;
  }
</style>
