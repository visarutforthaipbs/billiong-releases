---
import { ChevronDown, HelpCircle } from '@lucide/astro';

const title = "คำถามที่พบบ่อย (FAQ)";
const questions = [
  {
    q: "แอปนี้ต้องจ่ายค่าบริการรายเดือนไหม?",
    a: "ไม่ต้องจ่ายรายเดือนครับ บิลง่าย เป็นแอปพลิเคชันแบบ Local-first ที่รันบนเครื่องของคุณ ข้อมูลถูกเก็บไว้ในไฟล์บนคอมพิวเตอร์ของคุณเอง ไม่มีค่าบริการแอบแฝง"
  },
  {
    q: "ข้อมูลจะหายไหมถ้าคอมพิวเตอร์พัง?",
    a: "สำเนาในดิสก์เดียวกันอาจหายพร้อมเครื่องได้ เก็บฐานข้อมูล JSON และชุดไฟล์หลักฐานแยกกันนอกดิสก์เดิม JSON ไม่มีไฟล์แนบอยู่ข้างใน เก็บ PDF เดิมก่อนอัปเดต ซิงก์ Google Drive (Pro) ช่วยให้มีข้อมูลอีกชุดใน Drive ของคุณ แต่ยังควรส่งออกไฟล์สำรอง หากข้อมูลผิดปกติ หยุดแก้ไขและติดต่อฝ่ายช่วยเหลือ อย่าลบไฟล์เดิม"
  },
  {
    q: "เอกสารเก่าเปิดไม่ได้ ต้องยกเลิกก่อนหรือเปล่า?",
    a: "ไม่ต้องยกเลิกเพื่ออ่านครับ รุ่นปัจจุบัน (2.1.0) เปิดดูข้อมูลเดิมที่เก็บไว้ได้ และแยกเก็บเข้าคลังออกจากการยกเลิก เอกสารที่ไม่มีสำเนาข้อมูล ณ วันออกยังพิมพ์/แชร์ใหม่ไม่ได้ ใบแจ้งหนี้เก่าค้างรับที่เข้าเงื่อนไขสามารถแนบหลักฐานและยืนยันการรับเต็มจำนวนเป็นเงินบาทกับสถานะไม่จด VAT ได้ จากนั้นเลือกออกใบเสร็จธรรมดาใหม่ด้วยวันที่ออกวันนี้ ไม่แก้ต้นฉบับหรือสร้างหลักฐานย้อนหลัง"
  },
  {
    q: "Local กับ Pro ต่างกันยังไง?",
    a: "Local ฟรีสำหรับใช้เครื่องเดียว รองรับเอกสารตามข้อจำกัดของรุ่นนี้ รวมการจัดประเภทเงินได้ Pro เพิ่มซิงก์ Google Drive หลายเครื่อง ใช้ได้ทุกเครื่องที่ล็อกอิน Apple ID เดียวกัน และกู้คืนการซื้อได้ทุกเครื่อง ข้อจำกัดใบเสร็จและภาษีใช้กับทั้งสองแพ็กเกจ"
  },
  {
    q: "Pro ยังซิงก์ Google Drive ได้ไหม?",
    a: "ได้ ตั้งแต่ 2.0.12 ข้อมูลเก็บใน Google Drive ของคุณเอง ใช้ได้หลายเครื่อง ร่างได้แม้ออฟไลน์ แต่ออกเอกสารต้องต่ออินเทอร์เน็ตเพื่อให้เลขไม่ซ้ำ ถ้าแก้ข้อมูลเดียวกันพร้อมกัน แอปเก็บทั้งสองฉบับให้เลือก หากยังไม่เคยเชื่อมต่อ ให้เริ่มที่ ตั้งค่า → ข้อมูลและสำรอง ไฟล์หลักฐานแนบยังต้องส่งออกแยก"
  },
  {
    q: "ซื้อ Pro อย่างไร?",
    a: "ซื้อในแอป (In-App Purchase) ผ่าน Apple ID ของคุณ หลังติดตั้งแอปจาก App Store จ่ายครั้งเดียวไม่มีรายเดือน ใช้ได้ทุกเครื่องที่ล็อกอิน Apple ID เดียวกัน และกด \"กู้คืนการซื้อ\" ได้ทุกเครื่อง ผู้ใช้ Pro รหัสเดิมจากรุ่นเว็บ ซิงก์ต่อได้ตามเดิมโดยไม่ต้องซื้อใหม่"
  },
  {
    q: `BillNgai Local ฟรีจริงไหม แล้วต้องจ่ายเพิ่มทีหลังหรือเปล่า?`,
    a: `Local ฟรีสำหรับฟีเจอร์ที่รองรับ ไม่มีค่าใช้จ่ายภายหลัง ไม่ต้องซื้อ Pro เพื่อจัดประเภทเงินได้ Pro ซื้อในแอปครั้งเดียว ฿599 ไม่มีรายเดือน สำหรับซิงก์หลายเครื่อง`
  },
  {
    q: "BillNgai ใช้แทนนักบัญชีได้ไหม?",
    a: "ไม่ได้ครับ การทดสอบซอฟต์แวร์ไม่ใช่การรับรองจากนักบัญชีหรือที่ปรึกษากฎหมาย รุ่น 2.1.0 ไม่แสดงภาษีที่ต้องจ่ายหรือขอคืน ตรวจสถานะ VAT หลักฐานรับเงิน และหัก ณ ที่จ่ายกับผู้เชี่ยวชาญก่อนใช้จริง"
  },
  {
    q: "ระบบ PromptPay QR ปลอดภัยไหม?",
    a: "สร้าง QR ในเครื่องโดยไม่ใช้บริการสร้าง QR ภายนอก แต่ควรสแกนตรวจชื่อผู้รับและยอดเงินทุกครั้ง QR ไม่ใช่หลักฐานว่ารับชำระแล้ว"
  }
];
---

<section id="faq" class="py-20 md:py-28 bg-white border-t border-border-custom">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center justify-center p-2.5 rounded-full bg-primary/10 text-accent-ink mb-4">
        <HelpCircle size={24} />
      </div>
      <h2 class="text-3xl font-bold text-slate-900 tracking-tight">
        {title}
      </h2>
      <p class="text-text-muted text-sm md:text-base mt-2">
        ตอบทุกข้อสงสัยเกี่ยวกับระบบบัญชี Local-First และการจัดการความปลอดภัย
      </p>
    </div>

    <!-- Accordion Details list -->
    <div class="space-y-4">
      {questions.map((item) => (
        <details class="group border border-border-custom rounded-md overflow-hidden bg-slate-50/10 open:bg-white open:shadow-2xs transition-all duration-200">
          <summary class="flex items-center justify-between p-5 text-sm md:text-base font-bold text-slate-800 cursor-pointer list-none select-none focus:outline-none hover:text-accent-ink hover:bg-slate-50/30">
            <span>{item.q}</span>
            <span class="chevron-wrapper text-text-muted group-hover:text-accent-ink transition-transform duration-300">
              <ChevronDown size={18} />
            </span>
          </summary>
          <div class="p-5 pt-0 text-sm md:text-base text-text-muted border-t border-border-custom/50 leading-relaxed bg-white">
            {item.a}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  summary {
    display: flex;
  }
  details[open] .chevron-wrapper {
    transform: rotate(180deg);
    color: var(--color-accent-ink);
  }
</style>
