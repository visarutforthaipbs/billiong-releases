---
import { Check, Download, Sparkles, Cloud, ShieldCheck, ArrowRight } from '@lucide/astro';
import { product } from '../config/product';

// Local is free. Pro (one-time) adds Google Drive sync across Macs and the offline AI add-on.

const localFeatures = [
  "ใบเสนอราคาและใบแจ้งหนี้ — ตรวจข้อมูลก่อนใช้",
  "ใบเสร็จธรรมดา: ผู้ไม่จด VAT รับเต็มจำนวนเป็นเงินบาท",
  "จัดประเภทเงินได้ฟรี · ตรวจหัก ณ ที่จ่ายเอง",
  "ส่งออกข้อมูล CSV/ZIP ให้นักบัญชีตรวจ",
  "สำรองข้อมูลในเครื่อง — ควรเก็บอีกชุดนอกดิสก์เดิม",
  "พักใบกำกับภาษี ประมาณการภาษี และ e-Tax",
];

const proFeatures = [
  "ทุกอย่างที่มีใน Local",
  "ซิงก์ Google Drive หลายเครื่อง (ใหม่ 2.0.12) — ข้อมูลเก็บใน Drive ของคุณเอง",
  "เลขเอกสารไม่ซ้ำระหว่างเครื่อง แก้ข้อมูลชนกันเก็บทั้งสองฉบับให้เลือก",
  "สูงสุด 3 บัญชี Google ต่อรหัส · ออกเอกสารต้องต่ออินเทอร์เน็ต",
  "AI แปลง TOR เป็นใบเสนอราคา ประมวลผลในเครื่อง (ติดตั้งโมดูลแยก)",
  "ข้อจำกัดใบเสร็จและภาษีเหมือน Local",
];
---

<section id="plans" class="py-20 md:py-28 bg-white border-t border-border-custom relative overflow-hidden">
  <div class="absolute top-[-5%] right-[-10%] w-[500px] h-[300px] bg-primary/5 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14 space-y-4">
      <span class="text-xs font-bold text-primary bg-primary/10 border border-primary/20 px-3 py-1 rounded-full uppercase tracking-wider">
        Mac Direct 2.0.12
      </span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        สองแพ็กเกจ จ่ายครั้งเดียว ไม่มีรายเดือน
      </h2>
      <p class="text-slate-500 text-sm md:text-base leading-relaxed">
        อ่านข้อจำกัด 2.0.12 ก่อนเลือกแพ็กเกจ<br class="hidden sm:block" />
        ไม่ว่าแพ็กเกจไหน <strong class="text-slate-900 font-semibold">BillNgai ไม่เก็บเอกสารลูกค้าบนเซิร์ฟเวอร์เรา</strong>
      </p>
      <p class="text-slate-400 text-xs md:text-sm leading-relaxed">
        Local สำหรับใช้เครื่องเดียว · Pro เพิ่มซิงก์ Google Drive หลายเครื่องและโมดูล AI
      </p>
    </div>

    <!-- Plan Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">

      <!-- Local -->
      <div class="bg-white border border-border-custom rounded-md p-6 sm:p-8 shadow-sm flex flex-col">
        <div class="flex items-center gap-2 mb-1">
          <ShieldCheck size={18} class="text-primary shrink-0" />
          <h3 class="text-lg font-extrabold text-slate-900">BillNgai Local</h3>
        </div>
        <p class="text-xs text-slate-500 mb-5">ใช้เอกสารที่รองรับได้ฟรี ข้อมูลอยู่ในเครื่อง</p>

        <div class="mb-6">
          <div class="flex items-baseline gap-2">
            <span class="text-4xl font-extrabold text-slate-900 font-display">{product.prices.local.earlyBirdLabel}</span>
            <span class="text-xs font-bold text-white bg-primary px-2 py-0.5 rounded-full uppercase tracking-wide">ฟรี 100%</span>
          </div>
          <p class="text-[11px] text-slate-400 mt-1.5">ดาวน์โหลดฟรี ใช้ได้ตลอด — ข้อมูลอยู่ในเครื่องคุณ</p>
        </div>

        <ul class="space-y-2.5 text-sm text-slate-600 flex-1">
          {localFeatures.map((f) => (
            <li class="flex items-start gap-2.5">
              <Check size={15} class="text-primary shrink-0 mt-0.5" />
              <span>{f}</span>
            </li>
          ))}
        </ul>

        <a
          href="#download"
          class="mt-7 w-full inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold text-white bg-primary hover:bg-primary-hover rounded-sm shadow-sm transition-all active:scale-98 cursor-pointer"
        >
          <Download size={15} />
          ดาวน์โหลดฟรี
        </a>
      </div>

      <!-- Pro -->
      <div class="bg-[#FFF9F3] border-2 border-primary/60 rounded-md p-6 sm:p-8 shadow-md flex flex-col relative overflow-hidden">
        <span class="absolute top-4 right-4 text-[10px] font-bold text-primary bg-white border border-primary/30 px-2.5 py-1 rounded-full uppercase tracking-wider">
          ซื้อสิทธิ์ Early Bird
        </span>
        <div class="flex items-center gap-2 mb-1">
          <Sparkles size={18} class="text-primary shrink-0" />
          <h3 class="text-lg font-extrabold text-slate-900">BillNgai Pro</h3>
          <span class="text-[10px] font-bold text-slate-500">Sync + AI</span>
        </div>
        <p class="text-xs text-slate-500 mb-5">ใช้ข้อมูลชุดเดียวกันบนหลายเครื่องผ่าน Google Drive ของคุณ และ AI ช่วยร่างใบเสนอราคาในเครื่อง</p>

        <div class="mb-6">
          <div class="flex items-baseline gap-2">
            <span class="text-4xl font-extrabold text-slate-900 font-display">{product.prices.pro.earlyBirdLabel}</span>
            <span class="text-xs font-bold text-white bg-primary px-2 py-0.5 rounded-full uppercase tracking-wide">Early Bird</span>
          </div>
          <p class="text-[11px] text-slate-400 mt-1.5">จ่ายครั้งเดียว ไม่มีรายเดือน — ราคาเต็ม <span class="font-display">{product.prices.pro.fullLabel}</span> หลังช่วงเปิดตัว</p>
        </div>

        <ul class="space-y-2.5 text-sm text-slate-600 flex-1">
          {proFeatures.map((f) => (
            <li class="flex items-start gap-2.5">
              <Check size={15} class="text-primary shrink-0 mt-0.5" />
              <span>{f}</span>
            </li>
          ))}
        </ul>

        <div class="mt-5 flex items-start gap-2 text-[11px] text-slate-500 bg-white/70 border border-border-custom rounded-md p-3">
          <Cloud size={13} class="text-primary shrink-0 mt-0.5" />
          <span><strong class="text-slate-700">ผู้ใช้ Pro เดิม:</strong> อัปเดตเป็น 2.0.12 แล้วเชื่อมต่อซิงก์ใหม่ที่ ตั้งค่า → ข้อมูลและสำรอง ด้วยรหัสเดิม</span>
        </div>

        <a
          href="#pro-order"
          class="mt-4 w-full inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold text-primary bg-white border-2 border-primary hover:bg-primary hover:text-white rounded-sm shadow-sm transition-all active:scale-98 cursor-pointer"
        >
          <span>ซื้อ Pro Early Bird {product.prices.pro.earlyBirdLabel}</span>
          <ArrowRight size={15} />
        </a>
      </div>

    </div>
  </div>
</section>
