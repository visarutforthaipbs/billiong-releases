---
import { Download, ArrowRight } from '@lucide/astro';
import { product } from '../config/product';
---

<section id="hero" class="py-12 md:py-20 bg-canvas">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
    <div class="space-y-6" data-motion="reveal">
      <div class="flex items-center gap-3">
        <img src="/assets/brand/clay/logo-b-clay.webp" alt="" width="640" height="640" class="w-16 h-16" />
        <span class="text-sm font-semibold text-text-muted">Mac {product.downloads.mac.version} · Windows {product.downloads.windows.version} Beta</span>
      </div>
      <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-text-dark leading-tight">บิลง่าย</h1>
      <p class="text-3xl md:text-4xl font-bold leading-snug text-text-dark">ออกบิลไว เก็บเงินง่าย<br /><span class="text-accent-ink">สำหรับฟรีแลนซ์ไทย</span></p>
      <p class="text-base md:text-lg text-text-muted leading-relaxed max-w-xl">สร้างใบเสนอราคา ใบแจ้งหนี้ และจัดข้อมูลให้นักบัญชี<br class="hidden sm:block" /> ข้อมูลหลักอยู่ในเครื่องคุณ ใช้ Local ได้ฟรี</p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="#download" class="clay-button clay-button-primary"><Download size={18} />ดาวน์โหลดฟรี</a>
        <a href="#plans" class="clay-button clay-button-secondary">ดู Local และ Pro<ArrowRight size={18} /></a>
      </div>
      <div class="text-sm text-text-muted leading-relaxed space-y-2 max-w-xl">
        <p>ใบเสร็จธรรมดาสำหรับผู้ไม่จด VAT รับเต็มจำนวนเป็นเงินบาท ไม่รองรับใบกำกับภาษี ตรวจยอดและภาษีหัก ณ ที่จ่ายก่อนออกเอกสาร</p>
        <a href="#web-app" class="inline-flex items-center gap-1 text-accent-ink font-semibold underline underline-offset-4">อ่านข้อจำกัดและคำแนะนำก่อนอัปเดต<ArrowRight size={15} /></a>
      </div>
    </div>
    <figure class="clay-panel p-6 sm:p-8 relative" data-motion="reveal" data-motion-order="1">
      <div class="flex items-center justify-between gap-4">
        <span class="text-sm font-semibold text-text-muted">พื้นที่ทำงานที่เป็นของคุณ</span>
        <span class="text-xs font-semibold text-accent-ink bg-primary/10 px-3 py-1.5 rounded-full">Local-First</span>
      </div>
      <div class="clay-hero-stage" data-motion="hero">
      <img src="/assets/brand/clay/promo-hero.webp" alt="พื้นที่ทำงานดินปั้น พร้อมแล็ปท็อป เอกสาร แก้วสีส้ม และต้นไม้" width="1024" height="1024" fetchpriority="high" class="clay-art w-full aspect-square" />
      </div>
      <figcaption class="border-t border-border-custom pt-4 text-sm text-text-muted leading-relaxed">งานเอกสารอยู่ใกล้มือ ข้อมูลอยู่ใกล้ตัว<br /><strong class="text-text-dark">Pro เพิ่มซิงก์ Google Drive ของคุณเอง</strong></figcaption>
    </figure>
  </div>
</section>
