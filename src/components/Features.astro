---
import { LayoutGrid } from '@lucide/astro';

const sectionTitle = "ฟีเจอร์ที่คิดมาเพื่อ ธุรกิจและฟรีแลนซ์ไทย";
const sectionSubtitle = "ฟีเจอร์และข้อจำกัดของ Mac Direct 2.0.12 — ตรวจข้อมูลก่อนออกเอกสารทุกครั้ง";

const items = [
  {
    iconUrl: "/assets/brand/clay/promo-ai-quote.webp",
    title: "AI แปลง TOR เป็นใบเสนอราคา",
    badge: "Pro",
    description: "Pro สำหรับ Mac Direct ใช้โมดูลเสริมร่างใบเสนอราคาจาก PDF/TXT หรือข้อความ ประมวลผลในเครื่อง ต้องติดตั้งโมดูลเพิ่มและตรวจทุกรายการก่อนใช้ ไม่ใช่คำแนะนำภาษี"
  },
  {
    iconUrl: "/assets/brand/clay/promo-drive-sync.webp",
    title: "ซิงก์ Google Drive หลายเครื่อง",
    badge: "ใหม่ 2.0.12 · Pro",
    description: "ใช้ข้อมูลชุดเดียวกันบนหลายเครื่อง เก็บใน Google Drive ของคุณเอง ร่างได้แม้ออฟไลน์ ออกเอกสารต้องต่ออินเทอร์เน็ตเพื่อให้เลขไม่ซ้ำ แก้ข้อมูลชนกันแอปเก็บทั้งสองฉบับให้เลือก ไฟล์หลักฐานแนบยังต้องส่งออกแยก"
  },
  {
    iconUrl: "/assets/brand/clay/promo-income-summary.webp",
    title: "จัดข้อมูลให้นักบัญชี",
    badge: "Local ฟรี",
    description: "จัดประเภทเงินได้และตรวจรายการรับเงินได้ฟรี ไม่แสดงประมาณการภาษีที่ต้องจ่ายหรือขอคืน ตัวเลขในแอปไม่ใช่แบบยื่น ภ.ง.ด.90/94"
  },
  {
    iconUrl: "/assets/brand/clay/promo-documents.webp",
    title: "ร่างใบเสนอราคาและใบแจ้งหนี้",
    badge: "ตรวจยอดก่อนส่ง",
    description: "เตรียมรายการงานและยอดเรียกเก็บ ใบเสร็จรับเงินรองรับเฉพาะชำระเต็มจำนวน ไม่รองรับรับบางส่วน มัดจำ หรือกระบวนการคืนเงิน"
  },
  {
    iconUrl: "/assets/brand/clay/promo-accountant-export.webp",
    title: "ส่งออกชุดให้บัญชี",
    badge: "Local ฟรี",
    description: "ส่งออก CSV/ZIP เพื่อให้นักบัญชีตรวจร่วมกับหลักฐานจริง ข้อมูลเก่าหรือข้อมูลไม่ครบต้องตรวจเพิ่ม ไม่ใช่แบบยื่นภาษี และพักการส่งออก e-Tax XML"
  },
  {
    iconUrl: "/assets/brand/clay/promo-readable-backup.webp",
    title: "Readable Backup — สำรองที่เปิดอ่านได้จริง",
    description: "เก็บฐานข้อมูล JSON และชุดไฟล์หลักฐานแยกกันนอกดิสก์เดิม JSON ไม่มีไฟล์แนบอยู่ข้างใน เก็บ PDF เดิมก่อนอัปเดต สำเนาในดิสก์เดียวกันไม่ป้องกันเครื่องพัง"
  },
  {
    iconUrl: "/assets/brand/clay/promo-simple-receipt.webp",
    title: "ใบเสร็จธรรมดา ไม่ใช่ใบกำกับภาษี",
    description: "ผู้ไม่จด VAT ต้องยืนยันสถานะก่อนออกใบเสร็จรับเต็มจำนวนเป็นเงินบาท ตรวจภาษีหัก ณ ที่จ่ายตามรายการจริง ไม่ใช้อัตรา 3% อัตโนมัติ ผู้จด VAT และใบเสร็จเงินต่างประเทศยังไม่รองรับ"
  },
  {
    iconUrl: "/assets/brand/clay/promo-wht-certificate.webp",
    title: "50 ทวิ Tracking",
    description: "ติดตามหนังสือรับรองหัก ณ ที่จ่ายจากผู้จ่ายเงิน ตรวจยอดกับต้นฉบับก่อนใช้ประกอบภาษี แอปไม่รับรองสิทธิใช้เครดิตภาษี"
  },
  {
    iconUrl: "/assets/brand/clay/promo-promptpay.webp",
    title: "Native PromptPay QR",
    description: "สร้างคิวอาร์โค้ดพร้อมเพย์ (EMVCo) รูปแบบ SVG ลงบนเอกสารทันที รันจาก Source Code ของแอป 100% ไม่มีการส่งข้อมูลผ่าน API หรือเซิร์ฟเวอร์ภายนอก"
  }
];
---

<section id="features" class="py-20 md:py-28 bg-white relative border-b border-border-custom">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20" data-motion="reveal">
      <div class="inline-flex items-center justify-center p-2.5 rounded-full bg-primary/10 text-accent-ink mb-4">
        <LayoutGrid size={24} />
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-4">
        {sectionTitle}
      </h2>
      <p class="text-text-muted text-base md:text-lg">
        {sectionSubtitle}
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {items.map((item, index) => {
        return (
          <div data-motion="reveal" data-motion-order={index % 3} class="clay-feature-card p-6 rounded-md border border-border-custom bg-white hover:border-primary/40 transition-colors duration-200 group">
            <div class="flex justify-center mb-4 bg-white">
              <img src={item.iconUrl} alt="" width="768" height="768" loading="lazy" decoding="async" class="clay-art w-48 h-48" />
            </div>
            <!-- Title -->
            <h3 class="text-lg font-bold text-text-dark mb-2 flex flex-wrap items-center gap-2">
              <span>{item.title}</span>
              {item.badge && (
                <span class="text-[10px] font-bold text-accent-ink bg-[#FF6B00]/10 border border-[#FF6B00]/25 px-1.5 py-0.5 rounded-md shrink-0">
                  {item.badge}
                </span>
              )}
            </h3>
            <!-- Description -->
            <p class="text-sm text-text-muted leading-relaxed">
              {item.description}
            </p>
          </div>
        );
      })}
    </div>

  </div>
</section>
