---
import { LayoutGrid } from '@lucide/astro';

const sectionTitle = "ฟีเจอร์ที่คิดมาเพื่อ ธุรกิจและฟรีแลนซ์ไทย";
const sectionSubtitle = "จัดการเรื่องภาษีและเอกสารที่น่าปวดหัว ให้เสร็จได้ในไม่กี่คลิก";

const items = [
  {
    iconUrl: "/assets/brand/icons/set-1-14-report.png",
    title: "ผู้ช่วยยื่นภาษี ภ.ง.ด.90/94",
    badge: "ใหม่ v1.2",
    description: "สรุปตัวเลขพร้อมยื่นแยกสองงวดตามจริง: เงินได้พึงประเมิน เครดิตหัก ณ ที่จ่าย และประมาณการภาษีตามขั้นบันได พร้อมแบนเนอร์เตือนเมื่อใกล้กำหนดยื่น"
  },
  {
    iconUrl: "/assets/brand/icons/set-1-02-invoice.png",
    title: "แบ่งงวดตาม TOR",
    badge: "ใหม่ v1.3",
    description: "แบ่งใบเสนอราคาเป็นใบแจ้งหนี้หลายงวด (%, จำนวนเงิน — งวดสุดท้ายปรับยอดให้ครบอัตโนมัติ) พร้อมแถบความคืบหน้า ออกบิลแล้ว/ชำระแล้ว/คงเหลือ บนใบเสนอราคา"
  },
  {
    iconUrl: "/assets/brand/icons/set-3-08-archive.png",
    title: "ส่งออกชุดให้บัญชี",
    badge: "ใหม่ v1.2",
    description: "ปุ่มเดียวได้ ZIP ครบชุดของปีภาษี: สรุปยอดรวม VAT ทั้งปี รายเอกสาร รายการใบ 50 ทวิ และรายชื่อลูกค้าพร้อมเลขภาษี — ส่งนักบัญชีจบ ไม่ต้องแคปหน้าจอ"
  },
  {
    iconUrl: "/assets/brand/icons/set-1-13-tax.png",
    title: "Thai Tax Engine",
    description: "คำนวณ VAT (7%) และภาษีหัก ณ ที่จ่าย (3%) อัตโนมัติ พร้อมกฎพิเศษ: คำนวณ WHT เฉพาะยอดชำระสกุลเงินบาท (THB) เท่านั้น ป้องกันการคำนวณพลาด"
  },
  {
    iconUrl: "/assets/brand/icons/set-1-07-reminder.png",
    title: "50 ทวิ Tracking",
    description: "ระบบติดตามใบหัก ณ ที่จ่าย (ใบ 50 ทวิ) จากลูกค้า หมดปัญหาลืมทวงเอกสาร เพื่อให้คุณนำไปใช้เคลมเครดิตภาษีได้อย่างครบถ้วนตอนสิ้นปี"
  },
  {
    iconUrl: "/assets/brand/icons/set-4-10-qr-scan.png",
    title: "Native PromptPay QR",
    description: "สร้างคิวอาร์โค้ดพร้อมเพย์ (EMVCo) รูปแบบ SVG ลงบนเอกสารทันที รันจาก Source Code ของแอป 100% ไม่มีการส่งข้อมูลผ่าน API หรือเซิร์ฟเวอร์ภายนอก"
  }
];
---

<section id="features" class="py-20 md:py-28 bg-white relative border-b border-border-custom">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <div class="inline-flex items-center justify-center p-2.5 rounded-full bg-primary/10 text-primary mb-4">
        <LayoutGrid size={24} />
      </div>
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        {sectionTitle}
      </h2>
      <p class="text-slate-500 text-base md:text-lg">
        {sectionSubtitle}
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {items.map((item) => {
        return (
          <div class="p-6 rounded-md border border-border-custom bg-slate-50/10 hover:bg-white hover:-translate-y-1 hover:shadow-md hover:border-primary/20 transition-all duration-300 group">
            <!-- Icon Wrapper -->
            <div class="w-12 h-12 rounded-md bg-[#FFF9F3] border border-border-custom flex items-center justify-center mb-5 group-hover:border-primary/40 group-hover:bg-primary/5 transition-all duration-300">
              <img src={item.iconUrl} alt={item.title} class="w-7 h-7 object-contain group-hover:scale-105 transition-transform" />
            </div>
            <!-- Title -->
            <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
              <span>{item.title}</span>
              {item.badge && (
                <span class="text-[10px] font-bold text-[#E05E00] bg-[#FF6B00]/10 border border-[#FF6B00]/25 px-1.5 py-0.5 rounded-md shrink-0">
                  {item.badge}
                </span>
              )}
            </h3>
            <!-- Description -->
            <p class="text-sm text-slate-500 leading-relaxed">
              {item.description}
            </p>
          </div>
        );
      })}
    </div>

  </div>
</section>
