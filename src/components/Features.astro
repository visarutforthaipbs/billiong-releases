---
import { LayoutGrid } from '@lucide/astro';

const sectionTitle = "ฟีเจอร์ที่คิดมาเพื่อ ธุรกิจและฟรีแลนซ์ไทย";
const sectionSubtitle = "ฟีเจอร์และข้อจำกัดของ Mac Direct 2.0.4 — ตรวจข้อมูลก่อนออกเอกสารทุกครั้ง";

const items = [
  {
    iconUrl: "/assets/brand/icons/set-1-09-edit.png",
    title: "AI แปลง TOR เป็นใบเสนอราคา",
    badge: "ใหม่ 2.0 · Pro",
    description: "Pro สำหรับ Mac Direct ใช้โมดูลเสริมร่างใบเสนอราคาจาก PDF/TXT หรือข้อความ ประมวลผลในเครื่อง ต้องติดตั้งโมดูลเพิ่มและตรวจทุกรายการก่อนใช้ ไม่ใช่คำแนะนำภาษี"
  },
  {
    iconUrl: "/assets/brand/icons/set-1-18-upload.png",
    title: "ซิงก์คลาวด์พักให้บริการ",
    badge: "ข้อจำกัด 2.0.4",
    description: "พักเชื่อมต่อ ซิงก์ และกู้คืนจาก Google Drive รวมถึง Pro ใช้งานข้อมูลในเครื่องเดียว อย่าเปิดฐานข้อมูลเดียวกันพร้อมกันหลายเครื่อง"
  },
  {
    iconUrl: "/assets/brand/icons/set-1-14-report.png",
    title: "จัดข้อมูลให้นักบัญชี",
    badge: "Local ฟรี",
    description: "จัดประเภทเงินได้และตรวจรายการรับเงินได้ฟรี ไม่แสดงประมาณการภาษีที่ต้องจ่ายหรือขอคืน ตัวเลขในแอปไม่ใช่แบบยื่น ภ.ง.ด.90/94"
  },
  {
    iconUrl: "/assets/brand/icons/set-1-02-invoice.png",
    title: "ร่างใบเสนอราคาและใบแจ้งหนี้",
    badge: "ตรวจยอดก่อนส่ง",
    description: "เตรียมรายการงานและยอดเรียกเก็บ ใบเสร็จรับเงินรองรับเฉพาะชำระเต็มจำนวน ไม่รองรับรับบางส่วน มัดจำ หรือกระบวนการคืนเงิน"
  },
  {
    iconUrl: "/assets/brand/icons/set-3-08-archive.png",
    title: "ส่งออกชุดให้บัญชี",
    badge: "ใหม่ v1.2",
    description: "ส่งออก CSV/ZIP เพื่อให้นักบัญชีตรวจร่วมกับหลักฐานจริง ข้อมูลเก่าหรือข้อมูลไม่ครบต้องตรวจเพิ่ม ไม่ใช่แบบยื่นภาษี และพักการส่งออก e-Tax XML"
  },
  {
    iconUrl: "/assets/brand/icons/set-1-08-download.png",
    title: "Readable Backup — สำรองที่เปิดอ่านได้จริง",
    description: "เก็บฐานข้อมูล JSON และชุดไฟล์หลักฐานแยกกันนอกดิสก์เดิม JSON ไม่มีไฟล์แนบอยู่ข้างใน เก็บ PDF เดิมก่อนอัปเดต สำเนาในดิสก์เดียวกันไม่ป้องกันเครื่องพัง"
  },
  {
    iconUrl: "/assets/brand/icons/set-1-13-tax.png",
    title: "ใบเสร็จธรรมดา ไม่ใช่ใบกำกับภาษี",
    description: "ผู้ไม่จด VAT ต้องยืนยันสถานะก่อนออกใบเสร็จรับเต็มจำนวนเป็นเงินบาท ตรวจภาษีหัก ณ ที่จ่ายตามรายการจริง ไม่ใช้อัตรา 3% อัตโนมัติ ผู้จด VAT และใบเสร็จเงินต่างประเทศยังไม่รองรับ"
  },
  {
    iconUrl: "/assets/brand/icons/set-1-07-reminder.png",
    title: "50 ทวิ Tracking",
    description: "ติดตามหนังสือรับรองหัก ณ ที่จ่ายจากผู้จ่ายเงิน ตรวจยอดกับต้นฉบับก่อนใช้ประกอบภาษี แอปไม่รับรองสิทธิใช้เครดิตภาษี"
  },
  {
    iconUrl: "/assets/brand/icons/set-4-10-qr-scan.png",
    title: "Native PromptPay QR",
    description: "สร้างคิวอาร์โค้ดพร้อมเพย์ (EMVCo) รูปแบบ SVG ลงบนเอกสารทันที รันจาก Source Code ของแอป 100% ไม่มีการส่งข้อมูลผ่าน API หรือเซิร์ฟเวอร์ภายนอก"
  }
];
---

<section id="features" class="py-20 md:py-28 bg-white relative border-b border-border-custom">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <div class="inline-flex items-center justify-center p-2.5 rounded-full bg-primary/10 text-primary mb-4">
        <LayoutGrid size={24} />
      </div>
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        {sectionTitle}
      </h2>
      <p class="text-slate-500 text-base md:text-lg">
        {sectionSubtitle}
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {items.map((item) => {
        return (
          <div class="p-6 rounded-md border border-border-custom bg-slate-50/10 hover:bg-white hover:-translate-y-1 hover:shadow-md hover:border-primary/20 transition-all duration-300 group">
            <!-- Icon Wrapper -->
            <div class="w-12 h-12 rounded-md bg-[#FFF9F3] border border-border-custom flex items-center justify-center mb-5 group-hover:border-primary/40 group-hover:bg-primary/5 transition-all duration-300">
              <img src={item.iconUrl} alt={item.title} class="w-7 h-7 object-contain object-center group-hover:scale-105 transition-transform" />
            </div>
            <!-- Title -->
            <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
              <span>{item.title}</span>
              {item.badge && (
                <span class="text-[10px] font-bold text-[#E05E00] bg-[#FF6B00]/10 border border-[#FF6B00]/25 px-1.5 py-0.5 rounded-md shrink-0">
                  {item.badge}
                </span>
              )}
            </h3>
            <!-- Description -->
            <p class="text-sm text-slate-500 leading-relaxed">
              {item.description}
            </p>
          </div>
        );
      })}
    </div>

  </div>
</section>
