---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AppDemo from '../components/AppDemo.astro';
import Features from '../components/Features.astro';
import Security from '../components/Security.astro';
import PricingComparison from '../components/PricingComparison.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Plans from '../components/Plans.astro';
import ReleaseNotice from '../components/ReleaseNotice.astro';
import DownloadDialog from '../components/DownloadDialog.astro';
import { Zap, AlertTriangle, Sparkles, MessageCircle } from '@lucide/astro';
import { getDownloadUrls, product } from '../config/product';

// Configuration: Change to 'github' to route downloads through GitHub Releases instead of Cloudflare R2
const DOWNLOAD_SOURCE = 'r2'; 

const downloadUrls = getDownloadUrls(DOWNLOAD_SOURCE);
---

<Layout>
	<!-- Top Scarcity & Urgency Banner -->
	<div class="bg-secondary text-white text-xs py-2.5 px-4 text-center font-medium tracking-wide flex items-center justify-center gap-1.5 relative z-50 shadow-sm border-b border-border-custom/10">
		<span class="inline-flex items-center justify-center gap-1 bg-primary text-on-primary text-[10px] font-bold px-2 py-0.5 rounded-lg uppercase tracking-wider ">
			<Zap size={10} class="fill-current shrink-0" />
				<span>ใหม่! {product.versionLabel}</span>
			</span>
		<span><strong class="text-accent-ink font-bold">Local ใช้ฟรี</strong> · Pro Early Bird <span class="font-display">{product.prices.pro.earlyBirdLabel}</span> รวมซิงก์ Google Drive <span class="text-white/60 hidden sm:inline">(จ่ายครั้งเดียว ไม่มีรายเดือน)</span></span>
	</div>

	<Navbar />
	<main>
		<Hero />
		<Features />
		<Security />
		<Plans />
		<PricingComparison />
		<AppDemo />
		<Faq />
	</main>
	<Footer />

	<DownloadDialog urls={downloadUrls} />

	<!-- BillNgai Pro (Early Bird) — PromptPay + ส่งสลิปทาง LINE -->
	<dialog id="pro-dialog" class="fixed inset-0 m-auto backdrop:bg-slate-900/60  bg-white rounded-lg p-6 mac-window-shadow border border-border-custom w-[calc(100%-2rem)] max-w-md focus:outline-none overflow-hidden">
		<div class="space-y-4 max-h-[85vh] flex flex-col">
			<!-- Header -->
			<div class="flex items-center justify-between shrink-0 pb-1">
				<h3 class="text-base md:text-lg font-bold text-slate-900 flex items-center gap-2">
					<Sparkles class="text-accent-ink shrink-0" size={18} />
					<span>ซื้อ BillNgai Pro (Early Bird)</span>
				</h3>
					<button id="close-pro-dialog-btn" type="button" aria-label="ปิดหน้าต่างซื้อสิทธิ์ Pro" class="w-11 h-11 shrink-0 rounded-full flex items-center justify-center text-text-muted hover:text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer text-sm font-semibold">✕</button>
			</div>

			<!-- Scrollable Content Area -->
			<div class="space-y-4 overflow-y-auto pr-1 flex-1 py-1">
				<ReleaseNotice />
				<p class="text-sm text-text-dark font-bold">Pro รวมซิงก์ Google Drive หลายเครื่อง (ใหม่ 2.0.13, สูงสุด 3 บัญชี Google ต่อรหัส) และโมดูล AI ร่างใบเสนอราคาในเครื่อง</p>
				<!-- Price info -->
				<div class="text-center text-text-muted text-xs md:text-sm leading-relaxed">
					ราคาพิเศษ Early Bird ไม่มีรายเดือน — ราคาเต็ม <span class="font-display">{product.prices.pro.fullLabel}</span> หลังช่วงเปิดตัว
					<div class="text-3xl font-bold text-accent-ink font-display mt-1">{product.prices.pro.earlyBirdLabel}.00</div>
				</div>

				<!-- PromptPay QR Code -->
				<div class="bg-slate-50 border border-border-custom rounded-md p-4 text-center">
					<img
						src={product.prices.pro.qrPath}
						alt="PromptPay QR Code 599 THB"
						class="w-40 h-40 mx-auto border border-slate-200 rounded-md p-1.5 bg-white shadow-xs"
					/>
					<div class="text-[11px] text-text-muted font-medium mt-2 flex items-center justify-center gap-1.5">
						<span class="w-1.5 h-1.5 rounded-full bg-primary "></span>
						สแกนจ่ายชำระเงิน แล้วทำตามขั้นตอนด้านล่าง
					</div>
				</div>

				<!-- How you get the key -->
				<div class="bg-emerald-50/60 border border-emerald-500/10 rounded-md p-3 text-left space-y-2">
					<div class="text-[11px] font-bold text-emerald-800 flex items-center gap-1.5">
						<MessageCircle size={12} class="text-[#06C755] shrink-0" />
						<span>รับรหัสใช้งาน Pro ทาง LINE — 3 ขั้นตอน</span>
					</div>
					<ol class="text-[11px] text-slate-600 leading-relaxed space-y-1 list-decimal pl-4 font-medium">
						<li>สแกนจ่าย <strong class="font-display">{product.prices.pro.earlyBirdLabel}</strong> ด้วย QR ด้านบน</li>
						<li>ส่ง<strong>สลิปโอนเงิน + อีเมลของคุณ</strong>มาทาง LINE (ปุ่มด้านล่าง)</li>
						<li>ทีมงานตรวจสอบสลิปและส่งรหัสเปิดใช้งาน (License Key) + ลิงก์ดาวน์โหลดตัวแอปให้ทันที</li>
					</ol>
					<p class="text-[10px] text-text-muted leading-normal">
						หมายเหตุ: รับรหัสทาง LINE ปกติไม่กี่นาที ไม่เกิน 24 ชม. รหัสผูกกับอีเมลคุณ ใช้ได้ทุกเครื่องของคุณเอง (สำหรับผู้ใช้ Local เดิม สามารถกรอกรหัส Pro ในแอปเพื่อปลดล็อกฟีเจอร์ได้ทันทีโดยไม่ต้องติดตั้งใหม่)
					</p>
				</div>
			</div>

			<!-- Action Buttons -->
			<div class="space-y-2 pt-2 border-t border-border-custom shrink-0">
				<a
					href={product.lineUrl}
					target="_blank"
					rel="noopener noreferrer"
					id="pro-line-btn"
					class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs font-bold text-white bg-[#06C755] hover:bg-[#05b04c] rounded-sm shadow-md transition-all active:scale-98 cursor-pointer text-center"
				>
					<MessageCircle size={14} />
					ส่งสลิปทาง LINE เพื่อรับรหัส Pro
				</a>
				<button
					id="switch-to-local"
					type="button"
					class="w-full py-2 text-[11px] font-semibold text-text-muted hover:text-accent-ink transition-colors cursor-pointer"
				>
					ใช้เครื่องเดียวก็พอ? BillNgai Local {product.prices.local.earlyBirdLabel} →
				</button>
				<button
					id="pro-dialog-cancel-btn"
					type="button"
					class="w-full py-2.5 text-xs font-semibold text-text-muted hover:text-slate-700 hover:bg-slate-50 border border-slate-200 transition-colors cursor-pointer rounded-sm"
				>
					ยกเลิก
				</button>
			</div>
		</div>
	</dialog>


	<!-- macOS installation guide (shown after clicking the .dmg download) -->
	<dialog id="mac-guide-dialog" class="fixed inset-0 m-auto backdrop:bg-slate-900/60  bg-white rounded-lg p-5 mac-window-shadow border border-border-custom w-[calc(100%-2rem)] max-w-lg focus:outline-none overflow-hidden">
		<div class="space-y-3.5 max-h-[88vh] flex flex-col">
			<!-- Header -->
			<div class="flex items-center justify-between shrink-0">
				<h3 class="text-sm md:text-base font-bold text-slate-900 flex items-center gap-2">
					<AlertTriangle class="text-amber-500 shrink-0" size={17} />
					<span>วิธีเปิดแอปครั้งแรกบน macOS</span>
				</h3>
				<button id="close-mac-guide-btn" type="button" aria-label="ปิดวิธีเปิดแอปบน macOS" class="w-11 h-11 shrink-0 rounded-full flex items-center justify-center text-text-muted hover:text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer text-sm font-semibold">✕</button>
			</div>

			<p class="text-[11px] md:text-xs text-text-muted leading-relaxed shrink-0">
				BillNgai {product.downloads.mac.version} สำหรับ {product.downloads.mac.minimumOS} ขึ้นไป รองรับ Intel และ Apple Silicon ตัวติดตั้งลงนามโดยนักพัฒนาและผ่านการตรวจ notarization ของ Apple แล้ว
			</p>

			<div class="overflow-y-auto flex-1 pr-0.5">
				<ol class="list-decimal pl-5 space-y-2 text-sm text-slate-600 leading-relaxed">
					<li>เปิดไฟล์ BillNgai ที่ดาวน์โหลดเสร็จแล้ว</li>
					<li>ลาก BillNgai ไปไว้ในโฟลเดอร์ Applications หากกำลังอัปเดต ให้ปิดแอปก่อนแล้วเลือกแทนที่</li>
					<li>เปิด BillNgai จาก Applications หาก macOS ถามยืนยันว่าเป็นแอปที่ดาวน์โหลดจากอินเทอร์เน็ต ให้กด “เปิด”</li>
				</ol>
				<p class="mt-3 text-xs text-text-muted leading-relaxed">สำรองข้อมูลและเก็บ PDF เดิมก่อนอัปเดต ผู้ใช้ Pro เชื่อมต่อซิงก์ได้ที่ ตั้งค่า → ข้อมูลและสำรอง หากขึ้นว่าแอปมีมัลแวร์ เสียหาย หรือตรวจสอบนักพัฒนาไม่ได้ ให้หยุดเปิดและติดต่อฝ่ายช่วยเหลือผ่านหน้า <a href="/support" class="font-semibold underline">ช่วยเหลือ</a> อย่าข้ามคำเตือนความปลอดภัย</p>
			</div>

			<button 
				id="mac-guide-ok-btn" 
				type="button"
				class="w-full py-2.5 text-xs font-bold text-on-primary bg-primary hover:bg-primary-hover transition-colors cursor-pointer rounded-full shrink-0"
			>
				เข้าใจแล้ว
			</button>
		</div>
	</dialog>
</Layout>

<script>
	const downloadDialog = document.getElementById('download-dialog') as HTMLDialogElement;
	const closeDialogBtn = document.getElementById('close-dialog-btn');
	const downloadConfirmBtn = document.getElementById('download-confirm-btn');
	const downloadConfirmBtnWin = document.getElementById('download-confirm-btn-win');
	const macGuideDialog = document.getElementById('mac-guide-dialog') as HTMLDialogElement;
	const closeMacGuideBtn = document.getElementById('close-mac-guide-btn');
	const macGuideOkBtn = document.getElementById('mac-guide-ok-btn');


	// BillNgai Local is free: the dialog goes straight to the downloads.
	document.querySelectorAll('a[href="#download"]').forEach(link => {
		link.addEventListener('click', (e) => {
			e.preventDefault();
			downloadDialog?.showModal();
		});
	});

	// Pro (Early Bird) purchase dialog — PromptPay + ส่งสลิปทาง LINE
	const proDialog = document.getElementById('pro-dialog') as HTMLDialogElement;
	document.querySelectorAll('a[href="#pro-order"]').forEach(link => {
		link.addEventListener('click', (e) => {
			e.preventDefault();
			proDialog?.showModal();
		});
	});
	document.getElementById('close-pro-dialog-btn')?.addEventListener('click', () => proDialog?.close());
	document.getElementById('pro-dialog-cancel-btn')?.addEventListener('click', () => proDialog?.close());
	proDialog?.addEventListener('click', (e) => { if (e.target === proDialog) proDialog.close(); });
	// สลับระหว่างไดอะล็อก Local ↔ Pro — ทุกปุ่มดาวน์โหลด (navbar/hero) เข้าถึงทั้งสองแพ็กเกจได้
	document.getElementById('switch-to-pro')?.addEventListener('click', () => {
		downloadDialog?.close();
		proDialog?.showModal();
	});
	document.getElementById('switch-to-local')?.addEventListener('click', () => {
		proDialog?.close();
		downloadDialog?.showModal();
	});


	function closeDialog() {
		downloadDialog?.close();
	}

	function closeMacGuide() {
		macGuideDialog?.close();
	}

	closeDialogBtn?.addEventListener('click', closeDialog);
		closeMacGuideBtn?.addEventListener('click', closeMacGuide);
	macGuideOkBtn?.addEventListener('click', closeMacGuide);


	downloadConfirmBtn?.addEventListener('click', () => {
		// macOS: start the download, then show the installation guide.
		closeDialog();
		setTimeout(() => {
			macGuideDialog?.showModal();
		}, 350);
	});

	downloadConfirmBtnWin?.addEventListener('click', () => {
		// Auto close dialog after a small delay to start download smoothly
		setTimeout(() => {
			closeDialog();
		}, 800);
	});

	downloadDialog?.addEventListener('click', (e) => {
		if (e.target === downloadDialog) {
			closeDialog();
		}
	});
	downloadDialog?.addEventListener('close', () => {
		downloadDialog.querySelectorAll('details').forEach(notes => { notes.open = false; });
	});

	macGuideDialog?.addEventListener('click', (e) => {
		if (e.target === macGuideDialog) {
			closeMacGuide();
		}
	});
</script>
