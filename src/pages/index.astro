---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AppDemo from '../components/AppDemo.astro';
import Features from '../components/Features.astro';
import Security from '../components/Security.astro';
import PricingComparison from '../components/PricingComparison.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Plans from '../components/Plans.astro';
import ReleaseNotice from '../components/ReleaseNotice.astro';
import DownloadDialog from '../components/DownloadDialog.astro';
import { Zap, Sparkles, MessageCircle } from '@lucide/astro';
import { product } from '../config/product';
---

<Layout>
	<!-- Top Scarcity & Urgency Banner -->
	<div class="bg-secondary text-white text-xs py-2.5 px-4 text-center font-medium tracking-wide flex items-center justify-center gap-1.5 relative z-50 shadow-sm border-b border-border-custom/10">
		<span class="inline-flex items-center justify-center gap-1 bg-primary text-on-primary text-[10px] font-bold px-2 py-0.5 rounded-lg uppercase tracking-wider ">
			<Zap size={10} class="fill-current shrink-0" />
				<span>ใหม่! {product.versionLabel}</span>
			</span>
		<span><strong class="text-accent-ink font-bold">Local ใช้ฟรี</strong> · Pro {product.prices.pro.label} ครั้งเดียว รวมซิงก์ Google Drive <span class="text-white/60 hidden sm:inline">(ไม่มีรายเดือน)</span></span>
	</div>

	<Navbar />
	<main>
		<Hero />
		<Features />
		<Security />
		<Plans />
		<PricingComparison />
		<AppDemo />
		<Faq />
	</main>
	<Footer />

	<DownloadDialog />

	<!-- BillNgai Pro — ซื้อในแอป (In-App Purchase) ผ่าน Apple ID -->
	<dialog id="pro-dialog" class="fixed inset-0 m-auto backdrop:bg-slate-900/60  bg-white rounded-lg p-6 mac-window-shadow border border-border-custom w-[calc(100%-2rem)] max-w-md focus:outline-none overflow-hidden">
		<div class="space-y-4 max-h-[85vh] flex flex-col">
			<!-- Header -->
			<div class="flex items-center justify-between shrink-0 pb-1">
				<h3 class="text-base md:text-lg font-bold text-slate-900 flex items-center gap-2">
					<Sparkles class="text-accent-ink shrink-0" size={18} />
					<span>ซื้อ BillNgai Pro ในแอป</span>
				</h3>
					<button id="close-pro-dialog-btn" type="button" aria-label="ปิดหน้าต่างข้อมูล Pro" class="w-11 h-11 shrink-0 rounded-full flex items-center justify-center text-text-muted hover:text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer text-sm font-semibold">✕</button>
			</div>

			<!-- Scrollable Content Area -->
			<div class="space-y-4 overflow-y-auto pr-1 flex-1 py-1">
				<ReleaseNotice />
				<p class="text-sm text-text-dark font-bold">Pro รวมซิงก์ Google Drive หลายเครื่อง — ข้อมูลเก็บใน Google Drive ของคุณเอง เลขเอกสารไม่ซ้ำระหว่างเครื่อง</p>
				<!-- Price info -->
				<div class="text-center text-text-muted text-xs md:text-sm leading-relaxed">
					ซื้อในแอป (In-App Purchase) ผ่าน Apple ID ของคุณ ไม่มีรายเดือน
					<div class="text-3xl font-bold text-accent-ink font-display mt-1">{product.prices.pro.label}<span class="text-sm font-semibold ml-1">ครั้งเดียว</span></div>
				</div>

				<!-- How it works -->
				<div class="bg-emerald-50/60 border border-emerald-500/10 rounded-md p-3 text-left space-y-2">
					<div class="text-[11px] font-bold text-emerald-800 flex items-center gap-1.5">
						<MessageCircle size={12} class="text-[#06C755] shrink-0" />
						<span>วิธีใช้งาน Pro</span>
					</div>
					<ol class="text-[11px] text-slate-600 leading-relaxed space-y-1 list-decimal pl-4 font-medium">
						<li>ดาวน์โหลด BillNgai ฟรีจาก App Store</li>
						<li>ซื้อ Pro ในแอป จ่ายครั้งเดียวจบ ไม่มีรายเดือน</li>
						<li>ใช้ได้ทุกเครื่องที่ล็อกอิน Apple ID เดียวกัน และกด "กู้คืนการซื้อ" ได้ทุกเครื่อง</li>
					</ol>
					<p class="text-[10px] text-text-muted leading-normal">
						หมายเหตุ: <strong>ผู้ใช้ Pro เดิม (รหัสจากรุ่นเว็บ)</strong> — ซิงก์ต่อได้ตามเดิมด้วยรหัสเดิม ไม่ต้องซื้อใหม่ หากยังไม่ได้เชื่อมต่อ ให้เริ่มที่ ตั้งค่า → ข้อมูลและสำรอง
					</p>
				</div>
			</div>

			<!-- Action Buttons -->
			<div class="space-y-2 pt-2 border-t border-border-custom shrink-0">
				<a
					href={product.appStore.url}
					target="_blank"
					rel="noopener noreferrer"
					id="pro-line-btn"
					class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs font-bold text-white bg-primary hover:bg-primary-hover rounded-sm shadow-md transition-all active:scale-98 cursor-pointer text-center"
				>
					เปิด App Store เพื่อดาวน์โหลดและซื้อ Pro ในแอป
				</a>
				<a
					href={product.lineUrl}
					target="_blank"
					rel="noopener noreferrer"
					id="pro-support-btn"
					class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs font-bold text-white bg-[#06C755] hover:bg-[#05b04c] rounded-sm shadow-md transition-all active:scale-98 cursor-pointer text-center"
				>
					<MessageCircle size={14} />
					ถามหรือช่วยเหลือทาง LINE
				</a>
				<button
					id="switch-to-local"
					type="button"
					class="w-full py-2 text-[11px] font-semibold text-text-muted hover:text-accent-ink transition-colors cursor-pointer"
				>
					ยังไม่ซื้อ? ใช้ Local ฟรีก่อน →
				</button>
				<button
					id="pro-dialog-cancel-btn"
					type="button"
					class="w-full py-2.5 text-xs font-semibold text-text-muted hover:text-slate-700 hover:bg-slate-50 border border-slate-200 transition-colors cursor-pointer rounded-sm"
				>
					ปิด
				</button>
			</div>
		</div>
	</dialog>
</Layout>

<script>
	const downloadDialog = document.getElementById('download-dialog') as HTMLDialogElement;
	const closeDialogBtn = document.getElementById('close-dialog-btn');

	// ดาวน์โหลดทุกปุ่ม (navbar/hero/plans) เปิด App Store panel เดียวกัน
	document.querySelectorAll('a[href="#download"]').forEach(link => {
		link.addEventListener('click', (e) => {
			e.preventDefault();
			downloadDialog?.showModal();
		});
	});

	// Pro — ซื้อในแอปผ่าน Apple ID
	const proDialog = document.getElementById('pro-dialog') as HTMLDialogElement;
	document.querySelectorAll('a[href="#pro-order"]').forEach(link => {
		link.addEventListener('click', (e) => {
			e.preventDefault();
			proDialog?.showModal();
		});
	});
	document.getElementById('close-pro-dialog-btn')?.addEventListener('click', () => proDialog?.close());
	document.getElementById('pro-dialog-cancel-btn')?.addEventListener('click', () => proDialog?.close());
	proDialog?.addEventListener('click', (e) => { if (e.target === proDialog) proDialog.close(); });
	document.getElementById('switch-to-local')?.addEventListener('click', () => {
		proDialog?.close();
		downloadDialog?.showModal();
	});

	function closeDialog() {
		downloadDialog?.close();
	}

	closeDialogBtn?.addEventListener('click', closeDialog);

	downloadDialog?.addEventListener('click', (e) => {
		if (e.target === downloadDialog) {
			closeDialog();
		}
	});
	downloadDialog?.addEventListener('close', () => {
		downloadDialog.querySelectorAll('details').forEach(notes => { notes.open = false; });
	});
</script>
