---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AppDemo from '../components/AppDemo.astro';
import Features from '../components/Features.astro';
import Security from '../components/Security.astro';
import PricingComparison from '../components/PricingComparison.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import MacOpenGuide from '../components/MacOpenGuide.astro';
import { Download, Zap, Heart, AlertTriangle } from '@lucide/astro';

// Configuration: Change to 'github' to route downloads through GitHub Releases instead of Cloudflare R2
const DOWNLOAD_SOURCE = 'r2'; 

const macDownloadUrl = DOWNLOAD_SOURCE === 'github'
  ? "https://github.com/visarutforthaipbs/local-bill-apps/releases/download/v1.4.0/BillNgai-1.4.0-universal.dmg"
  : "https://pub-4ed16d146bff4f168839661507e1748a.r2.dev/BillNgai-1.4.0-universal.dmg";

const winDownloadUrl = DOWNLOAD_SOURCE === 'github'
  ? "https://github.com/visarutforthaipbs/local-bill-apps/releases/download/v1.4.0/BillNgai%20Setup%201.4.0.exe"
  : "https://pub-4ed16d146bff4f168839661507e1748a.r2.dev/BillNgai%20Setup%201.4.0.exe";
---

<Layout title="บิลง่าย (BillNgai) — ออกบิลไว เก็บเงินง่าย จัดการภาษีฟรีแลนซ์ไทยครบจบในที่เดียว">
	<!-- Top Scarcity & Urgency Banner -->
	<div class="bg-secondary text-white text-xs py-2.5 px-4 text-center font-medium tracking-wide flex items-center justify-center gap-1.5 relative z-50 shadow-sm border-b border-border-custom/10">
		<span class="inline-flex items-center justify-center gap-1 bg-primary text-white text-[10px] font-bold px-2 py-0.5 rounded-lg uppercase tracking-wider animate-pulse">
			<Zap size={10} class="fill-current shrink-0" />
			<span>Early Bird Alpha</span>
		</span>
		<span>เหลือเพียง <strong class="text-primary font-bold">34 จาก 100 สิทธิ์สุดท้าย</strong> ในราคา <strong class="text-primary font-bold font-display">฿59</strong> <span class="text-white/60 hidden sm:inline">(หลังจากครบสิทธิ์จะปรับราคาขึ้นเป็น <span class="font-display">฿149</span> ทันที)</span></span>
	</div>

	<Navbar />
	<main>
		<Hero />
		<AppDemo />
		<Features />
		<Security />
		<PricingComparison />
		<Faq />
	</main>
	<Footer />

	<!-- macOS-Style Trust-Based Purchase & Download Dialog (Centered) -->
	<dialog id="download-dialog" class="fixed inset-0 m-auto backdrop:bg-slate-900/60 backdrop:backdrop-blur-xs bg-white rounded-lg p-6 mac-window-shadow border border-border-custom w-[calc(100%-2rem)] max-w-md focus:outline-none overflow-hidden">
		<div class="space-y-4 max-h-[85vh] flex flex-col">
			<!-- Header -->
			<div class="flex items-center justify-between shrink-0 pb-1">
				<h3 class="text-base md:text-lg font-bold text-slate-900 flex items-center gap-2">
					<Download class="text-primary shrink-0" size={18} />
					<span>ซื้อลิขสิทธิ์ บิลง่าย (Early Bird)</span>
				</h3>
				<button id="close-dialog-btn" class="w-6 h-6 rounded-full flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer text-sm font-semibold">✕</button>
			</div>
			
			<!-- Scrollable Content Area -->
			<div class="space-y-4 overflow-y-auto pr-1 flex-1 py-1">
				<!-- Price info -->
				<div class="text-center text-slate-500 text-xs md:text-sm leading-relaxed">
					สนับสนุนช่วงเริ่มต้น จ่ายครั้งเดียวใช้งานตลอดชีพ
					<div class="text-3xl font-extrabold text-primary font-display mt-1">฿59.00</div>
				</div>

				<!-- PromptPay QR Code -->
				<div class="bg-slate-50 border border-border-custom rounded-md p-4 text-center">
					<img 
						src="https://promptpay.io/0627283058/59.png" 
						alt="PromptPay QR Code 59 THB" 
						class="w-40 h-40 mx-auto border border-slate-200 rounded-md p-1.5 bg-white shadow-xs" 
					/>
					<div class="text-[11px] text-slate-500 font-medium mt-2 flex items-center justify-center gap-1.5">
						<span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
						สแกนจ่ายผ่านแอปธนาคาร จากนั้นกดดาวน์โหลดด้านล่าง
					</div>
				</div>

				<!-- Honor System & Support Info -->
				<div class="bg-emerald-50/60 border border-emerald-500/10 rounded-md p-3 text-left space-y-1">
					<div class="text-[11px] font-bold text-emerald-800 flex items-center justify-between">
						<span class="flex items-center gap-1.5">
							<Heart size={12} class="fill-current text-primary shrink-0" />
							<span>ระบบเชื่อใจกัน (Honor System)</span>
						</span>
						<a 
							href="https://lin.ee/pSl8nEH" 
							target="_blank" 
							rel="noopener noreferrer" 
							class="text-[10px] text-[#06C755] font-semibold hover:underline inline-flex items-center gap-0.5"
						>
							คุยทาง LINE
						</a>
					</div>
					<p class="text-[10px] text-slate-600 leading-normal">
						สแกนชำระเงินสนับสนุนการพัฒนาแอปฝีมือคนไทยแล้ว สามารถดาวน์โหลดไปใช้งานได้ทันทีครับ
					</p>
				</div>

				<!-- First-Run Quick Guide -->
				<div class="bg-amber-50/60 border border-amber-500/10 rounded-md p-3 text-left space-y-1.5">
					<div class="text-[11px] font-bold text-amber-800 flex items-center gap-1.5">
						<AlertTriangle size={12} class="text-amber-800 shrink-0" />
						<span>การเปิดใช้งานครั้งแรก (แอปทำงานแบบ Offline)</span>
					</div>
					<ul class="text-[10px] text-slate-600 leading-normal space-y-0.5 list-disc pl-4 font-medium">
						<li><strong>macOS</strong>: หากขึ้นเตือน “ยืนยันไม่ได้” ไปที่ <strong>System Settings → Privacy &amp; Security → Open Anyway</strong> (มีภาพประกอบตอนกดดาวน์โหลด)</li>
						<li><strong>Windows</strong>: หากเตือน SmartScreen ให้คลิก <strong>More info → Run anyway</strong></li>
					</ul>
				</div>
			</div>

			<!-- Action Buttons (Sticky at bottom) -->
			<div class="space-y-2 pt-2 border-t border-border-custom shrink-0">
				<div class="text-center text-[10px] font-semibold text-slate-400">
					เลือกดาวน์โหลดตามระบบปฏิบัติการของคุณ
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
					<a 
						href={macDownloadUrl} 
						download 
						id="download-confirm-btn" 
						class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-primary hover:bg-primary-hover rounded-sm shadow-md transition-all active:scale-98 cursor-pointer text-center"
					>
						<Download size={14} />
						macOS (.dmg)
					</a>
					<a 
						href={winDownloadUrl} 
						download 
						id="download-confirm-btn-win" 
						class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-primary hover:bg-primary-hover rounded-sm shadow-md transition-all active:scale-98 cursor-pointer text-center"
					>
						<Download size={14} />
						Windows (.exe)
					</a>
				</div>
				<button 
					id="dialog-cancel-btn" 
					class="w-full py-2.5 text-xs font-semibold text-slate-500 hover:text-slate-700 hover:bg-slate-50 border border-slate-200 transition-colors cursor-pointer rounded-sm"
				>
					ยกเลิก
				</button>
			</div>
		</div>
	</dialog>

	<!-- macOS "Open Anyway" Walkthrough (shown after clicking the .dmg download) -->
	<dialog id="mac-guide-dialog" class="fixed inset-0 m-auto backdrop:bg-slate-900/60 backdrop:backdrop-blur-xs bg-white rounded-lg p-5 mac-window-shadow border border-border-custom w-[calc(100%-2rem)] max-w-lg focus:outline-none overflow-hidden">
		<div class="space-y-3.5 max-h-[88vh] flex flex-col">
			<!-- Header -->
			<div class="flex items-center justify-between shrink-0">
				<h3 class="text-sm md:text-base font-bold text-slate-900 flex items-center gap-2">
					<AlertTriangle class="text-amber-500 shrink-0" size={17} />
					<span>วิธีเปิดแอปครั้งแรกบน macOS</span>
				</h3>
				<button id="close-mac-guide-btn" class="w-6 h-6 rounded-full flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer text-sm font-semibold">✕</button>
			</div>

			<p class="text-[11px] md:text-xs text-slate-500 leading-relaxed shrink-0">
				กำลังดาวน์โหลด BillNgai แล้ว! เนื่องจากแอปยังไม่ได้ลงทะเบียนกับ Apple (เพื่อคงราคาประหยัด) macOS จะเตือนตอนเปิดครั้งแรก ทำตาม 4 ขั้นตอนนี้ครั้งเดียวจบ
			</p>

			<div class="overflow-y-auto flex-1 pr-0.5">
				<MacOpenGuide />
			</div>

			<button 
				id="mac-guide-ok-btn" 
				class="w-full py-2.5 text-xs font-bold text-white bg-primary hover:bg-primary-hover transition-colors cursor-pointer rounded-sm shrink-0"
			>
				เข้าใจแล้ว
			</button>
		</div>
	</dialog>
</Layout>

<script>
	const downloadDialog = document.getElementById('download-dialog') as HTMLDialogElement;
	const closeDialogBtn = document.getElementById('close-dialog-btn');
	const dialogCancelBtn = document.getElementById('dialog-cancel-btn');
	const downloadConfirmBtn = document.getElementById('download-confirm-btn');
	const downloadConfirmBtnWin = document.getElementById('download-confirm-btn-win');
	const macGuideDialog = document.getElementById('mac-guide-dialog') as HTMLDialogElement;
	const closeMacGuideBtn = document.getElementById('close-mac-guide-btn');
	const macGuideOkBtn = document.getElementById('mac-guide-ok-btn');

	document.querySelectorAll('a[href="#download"]').forEach(link => {
		link.addEventListener('click', (e) => {
			e.preventDefault();
			downloadDialog?.showModal();
		});
	});

	function closeDialog() {
		downloadDialog?.close();
	}

	function closeMacGuide() {
		macGuideDialog?.close();
	}

	closeDialogBtn?.addEventListener('click', closeDialog);
	dialogCancelBtn?.addEventListener('click', closeDialog);
	closeMacGuideBtn?.addEventListener('click', closeMacGuide);
	macGuideOkBtn?.addEventListener('click', closeMacGuide);

	downloadConfirmBtn?.addEventListener('click', () => {
		// macOS: start the download, then show the "Open Anyway" walkthrough popup.
		closeDialog();
		setTimeout(() => {
			macGuideDialog?.showModal();
		}, 350);
	});

	downloadConfirmBtnWin?.addEventListener('click', () => {
		// Auto close dialog after a small delay to start download smoothly
		setTimeout(() => {
			closeDialog();
		}, 800);
	});

	downloadDialog?.addEventListener('click', (e) => {
		if (e.target === downloadDialog) {
			closeDialog();
		}
	});

	macGuideDialog?.addEventListener('click', (e) => {
		if (e.target === macGuideDialog) {
			closeMacGuide();
		}
	});
</script>
